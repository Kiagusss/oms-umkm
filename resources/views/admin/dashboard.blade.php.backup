    <!-- Time Tracker (Col span 3) -->
    <div class="flex flex-col justify-between rounded-[24px] p-6 shadow-md relative overflow-hidden wave-bg bg-gradient-to-b from-[#06180e] to-[#0c2f1b] text-white lg:col-span-3">
        <h2 class="text-sm font-bold tracking-tight text-emerald-450/80 uppercase">Time Tracker</h2>
        
        {{-- Interactive Alpine JS Live Ticking Clock --}}
        <div x-data="{
            time: 5048, {{-- Start time 01:24:08 (1 * 3600 + 24 * 60 + 8) --}}
            running: true,
            timer: null,
            formatTime() {
                let h = Math.floor(this.time / 3600);
                let m = Math.floor((this.time % 3600) / 60);
                let s = this.time % 60;
                return [h, m, s].map(v => v < 10 ? '0' + v : v).join(':');
            },
            init() {
                this.timer = setInterval(() => {
                    if (this.running) this.time++;
                }, 1000);
            }
        }" x-init="init()" class="mt-8 flex flex-col items-center">
            
            <p class="text-4xl font-extrabold tracking-widest font-mono text-white select-none drop-shadow-sm" x-text="formatTime()">
                01:24:08
            </p>
            
            <div class="mt-6 flex items-center gap-4">
                <!-- Play/Pause Button -->
                <button @click="running = !running" class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-[#0f4a2d] transition hover:bg-emerald-50 hover:scale-105 active:scale-95 shadow-sm" aria-label="Play/Pause">
                    <span x-show="running">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    </span>
                    <span x-show="!running" style="display: none;">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                </button>
                <!-- Stop/Reset Button -->
                <button @click="time = 0; running = false;" class="flex h-12 w-12 items-center justify-center rounded-full bg-rose-600/30 text-rose-300 border border-rose-500/40 transition hover:bg-rose-600/40 active:scale-95 shadow-sm" aria-label="Stop/Reset">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" /></svg>
                </button>
            </div>
        </div>
    </div>
</div>
