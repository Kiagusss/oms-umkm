# ─── Production environment template for Pempek Palembang ─────────────
# Copy ke .env lalu isi nilai sesuai environment.

# ─── App ──────────────────────────────────────────────────────────────
APP_NAME="Pempek Palembang"
APP_ENV=production
APP_KEY=                                # generate: php artisan key:generate
APP_DEBUG=false                         # WAJIB false di production
APP_URL=https://pempek-palembang.co.id  # WAJIB pakai https + domain asli

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12                        # naikkan ke 14+ jika CPU kuat

# ─── Logging ──────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                       # debug/info = noisy di production

# ─── Database ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql                    # SQLite = single writer bottleneck
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pempek_prod
DB_USERNAME=                            # jangan root
DB_PASSWORD=

# ─── Session / Cache / Queue ──────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true                    # true di production
SESSION_PATH=/
SESSION_DOMAIN=null                    # set ke .pempek-palembang.co.id jika multi-subdomain

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis                       # database OK, redis lebih cepat

# ─── Redis (opsional, sangat direkomendasikan) ────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (sesuaikan provider) ────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@pempek-palembang.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS S3 (untuk backup file upload) ────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1       # Singapore untuk region ID
AWS_BUCKET=pempek-uploads
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Admin & Kontak ───────────────────────────────────────────────────
# WAJIB di-set! Default value (admin@pempek.com / admin123) = SECURITY HOLE
ADMIN_EMAIL=admin@pempek-palembang.co.id
ADMIN_PASSWORD=                         # bcrypt hash, BUKAN plain. Generate: php -r "echo password_hash('PASSWORD_ASLI', PASSWORD_BCRYPT);"
WA_NUMBER=6281234567890                 # format intl tanpa +
INSTAGRAM=
FACEBOOK=
TIKTOK=

# ─── Monitoring / Error tracking (opsional tapi recommended) ──────────
SENTRY_LARAVEL_DSN=                     # https://sentry.io → buat project → copy DSN
